@page "/Teacher"
@inherits TeacherPageViewModel
@using school.web.Components.Pages.Teacher
@rendermode InteractiveServer
<h3>Учителя</h3>


<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Фамилия</th>
            <th>Имя</th>
            <th>Отчество</th>
            <th>Возраст</th>
            <th>Предмет</th>
            <th></th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var teacher in Teachers)
        {
            <tr>
                <td>@teacher.Id</td>
                <td>@teacher.LastName</td>
                <td>@teacher.FirstName</td>
                <td>@teacher.MiddleName</td>
                <td>@teacher.Age</td>
                <td>@teacher.SubjectName</td>
                <td><i class="btn btn-success bi bi-pencil" @onclick="@(() => SelectTeacher(teacher))"></i></td>
                <td><button class="btn btn-secondary bi bi-trash" @onclick="@(() => DeleteTeacher(teacher))"> Удалить учителя</button></td>
            </tr>
        }
    </tbody>
</table>
<button class="btn btn-secondary bi bi-plus-lg" @onclick="@(() => AddNewTeacher())"> Добавить учителя</button>
<EditTeacherDialog ViewModel="EditModel" Save="SaveChanges"></EditTeacherDialog>


